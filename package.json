{
  "name": "compare-databases",
  "version": "2.1.0",
  "description": "Compare Databases",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.rabar.comparedatabases",
    "productName": "Compare Databases",
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "rabarvp1",
      "repo": "compare-databases",
      "releaseType": "release",
      "vPrefixedTagName": false
    },
    "win": {
      "target": "nsis",
      "icon": "super-cashier.ico"
    },
    "nsis": {
      "artifactName": "Compare-Databases-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "mysql2": "^3.9.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  }
}
